{
  "branch": "main",
  "files": [
    {
      "content": "name: Build JAR Client\n\non:\n  push:\n    branches: [ main, develop ]\n  pull_request:\n    branches: [ main ]\n  workflow_dispatch:\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    \n    steps:\n    - name: Checkout code\n      uses: actions/checkout@v3\n    \n    - name: Setup Java\n      uses: actions/setup-java@v3\n      with:\n        java-version: '11'\n        distribution: 'temurin'\n    \n    - name: Setup Gradle\n      uses: gradle/gradle-build-action@v2\n    \n    - name: Make gradlew executable\n      run: chmod +x gradlew\n    \n    - name: Build with Gradle\n      run: ./gradlew build -x test\n    \n    - name: Build JAR (Shadow JAR)\n      run: ./gradlew shadowJar\n    \n    - name: List build files\n      run: ls -lah build/libs/\n    \n    - name: Upload JAR Artifact\n      uses: actions/upload-artifact@v3\n      with:\n        name: MacNizes-Client-JAR\n        path: build/libs/*.jar\n        retention-days: 90\n    \n    - name: Create Release\n      if: startsWith(github.ref, 'refs/tags/')\n      uses: actions/create-release@v1\n      env:\n        GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n      with:\n        tag_name: ${{ github.ref }}\n        release_name: Release ${{ github.ref }}\n        draft: false\n        prerelease: false\n",
      "path": ".github/workflows/build.yml"
    },
    {
      "content": "name: Manual JAR Build\n\non:\n  workflow_dispatch:\n    inputs:\n      build_type:\n        description: 'Tipo de build'\n        required: true\n        default: 'standard'\n        type: choice\n        options:\n          - standard\n          - full\n          - lite\n\njobs:\n  build-jar:\n    runs-on: ubuntu-latest\n    \n    steps:\n    - name: Checkout Repository\n      uses: actions/checkout@v3\n    \n    - name: Setup Java 11\n      uses: actions/setup-java@v3\n      with:\n        java-version: '11'\n        distribution: 'temurin'\n        cache: gradle\n    \n    - name: Make Gradle executable\n      run: chmod +x gradlew\n    \n    - name: Clean build\n      run: ./gradlew clean\n    \n    - name: Build Project\n      run: ./gradlew build -x test --stacktrace\n    \n    - name: Create Shadow JAR\n      run: ./gradlew shadowJar --stacktrace\n    \n    - name: Generate JAR variants\n      run: |\n        mkdir -p dist\n        # Standard (100MB)\n        cp build/libs/MacNizes-Client-*.jar dist/MacNizes-Client-1.0.0-STANDARD.jar\n        # Simulate FULL and LITE (same JAR for now)\n        cp build/libs/MacNizes-Client-*.jar dist/MacNizes-Client-1.0.0-FULL.jar\n        cp build/libs/MacNizes-Client-*.jar dist/MacNizes-Client-1.0.0-LITE.jar\n        ls -lah dist/\n    \n    - name: Upload Standard JAR\n      uses: actions/upload-artifact@v3\n      with:\n        name: MacNizes-Client-1.0.0-STANDARD\n        path: dist/MacNizes-Client-1.0.0-STANDARD.jar\n        if-no-files-found: error\n    \n    - name: Upload Full JAR\n      uses: actions/upload-artifact@v3\n      with:\n        name: MacNizes-Client-1.0.0-FULL\n        path: dist/MacNizes-Client-1.0.0-FULL.jar\n        if-no-files-found: error\n    \n    - name: Upload Lite JAR\n      uses: actions/upload-artifact@v3\n      with:\n        name: MacNizes-Client-1.0.0-LITE\n        path: dist/MacNizes-Client-1.0.0-LITE.jar\n        if-no-files-found: error\n    \n    - name: Build Success!\n      run: |\n        echo \"✅ BUILD CONCLUÍDO COM SUCESSO!\"\n        echo \"\"\n        echo \"📦 Arquivos gerados:\"\n        ls -lh dist/\n        echo \"\"\n        echo \"✅ Baixe os arquivos na aba 'Artifacts'\"\n",
      "path": ".github/workflows/manual-build.yml"
    }
  ],
  "message": "Add GitHub Actions workflow for JAR compilation",
  "owner": "MacNize-dev",
  "repo": "MacNizes-s-Client-"
}
